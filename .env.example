# Omada Controller URL, usually https://<controller-ip>:8043
OMADA_URL=https://192.168.1.10:8043

# For local Omada Controller API. Use a read-only/local admin where possible.
OMADA_USERNAME=dashboard-user
OMADA_PASSWORD=change-me

# Controller ID is normally the random string in the Omada URL path after login.
# Example: https://192.168.1.10:8043/1234567890abcdef.../
OMADA_CONTROLLER_ID=PUT_CONTROLLER_ID_HERE

# Site name or ID. Try Default first. If it fails, open /api/sites from this app to see discovered sites.
OMADA_SITE=Default

# Set false only if you use a trusted certificate on the controller.
OMADA_ALLOW_SELF_SIGNED=true

# Dashboard refresh interval
REFRESH_SECONDS=10

# Optional: comma-separated MAC addresses or device names that are critical for the event kit
CRITICAL_DEVICES=starlink,main switch,gate
